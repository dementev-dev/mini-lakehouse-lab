# Копировать в .env необязательно: это значения по умолчанию.
# Если .env уже есть, добавь нужную настройку в него, сохранив остальные.

# GHCR — основной источник MinIO. Резерв того же автора и digest: docker.io.
MINIO_REGISTRY=ghcr.io

# На Linux при необходимости укажи свой UID и GID (команды: id -u; id -g).
NB_UID=1000
NB_GID=100
